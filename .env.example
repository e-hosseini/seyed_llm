# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-me
ADMIN_TELEGRAM_ID=111111111

# Claude subscription token, held only by LiteLLM. Run `claude setup-token` once and paste
# the full sk-ant-oat01- value (one line, about a year). Every sandbox session uses it.
ANTHROPIC_OAUTH_TOKEN=sk-ant-oat01-replace-me
# Optional fallback if ANTHROPIC_OAUTH_TOKEN is empty
# ANTHROPIC_API_KEY=sk-ant-api03-replace-me
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-string
POSTGRES_PASSWORD=replace-with-a-long-random-string

# Images built by GitHub Actions (lowercase owner/repo)
BOT_IMAGE=ghcr.io/OWNER/REPO/bot:latest
SANDBOX_IMAGE=ghcr.io/OWNER/REPO/sandbox:latest

# GitHub token with read:packages, used by the bot to pull the private sandbox image
GHCR_USER=your-github-username
GHCR_TOKEN=ghp_replace-me

# Optional
# SANDBOX_MODEL=claude-sonnet-5-5
# SANDBOX_SMALL_MODEL=claude-haiku-5-5
# SANDBOX_MEMORY_GB=2
# SANDBOX_CPUS=1
# SANDBOX_PIDS=512
# DEBOUNCE_MS=1500
